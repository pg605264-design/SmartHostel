# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.

SECRET_KEY=change-this-to-a-long-random-string
FLASK_ENV=development

# Leave unset to use the default local SQLite database.
# When ready to move to PostgreSQL, set e.g.:
# DATABASE_URL=postgresql://user:password@localhost:5432/smarthostel
DATABASE_URL=
